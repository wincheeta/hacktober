{
  "manifest_version": 3,
  "name": "Page HTML Logger",
  "version": "0.1.0",
  "description": "Logs the HTML of each page to the console after it finishes loading.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "page-html-logger@example.com"
    }
  }
}
