{
  "manifest_version": 3,
  "name": "Spookify",
  "version": "0.2.0",
  "description": "Makes every web page spooky: a dark orange/black theme plus decorations placed by a local Ollama model.",
  "permissions": ["storage", "declarativeNetRequestWithHostAccess", "offscreen"],
  "host_permissions": ["http://localhost:11434/*", "http://127.0.0.1:11434/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["spooks.js", "modules/prompts.js", "background.js"]
  },
  "action": {
    "default_title": "Spookify",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["theme.css", "spooks.css", "modules/skeletor.css"],
      "js": ["boot.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "spooks.js",
        "spooky-components/config.js",
        "spooky-components/components.js",
        "modules/moodle.js",
        "modules/skeletor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Pictures/*.gif", "Pictures/*.webp", "spooky-components/*.svg", "audio/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "spookify@hacktober.example",
      "strict_min_version": "121.0"
    }
  }
}
